# ═══════════════════════════════════════════════════════════
# SI PRESENSI PRO MAX — ENVIRONMENT VARIABLES
# ═══════════════════════════════════════════════════════════
# Copy file ini ke .env, .env.android, .env.production
# lalu isi dengan credential dari project Supabase kamu.
# ═══════════════════════════════════════════════════════════

# ─── WAJIB (Supabase) ────────────────────────────────────
# Dapatkan dari: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── OPSIONAL: Landing Page ──────────────────────────────
# Set ke 'false' untuk build Android (skip landing page, langsung login)
# VITE_INCLUDE_LANDING=true

# ─── OPSIONAL: Google Firebase Cloud Messaging (Push Notif) ──
# Dapatkan dari: console.firebase.google.com → Project Settings → Cloud Messaging
# VITE_FIREBASE_VAPID_KEY=your_vapid_key_here
# VITE_FIREBASE_API_KEY=your_api_key
# VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
# VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
# VITE_FIREBASE_APP_ID=your_firebase_app_id

# ─── OPSIONAL: Google Gemini AI (AI Chatbot HR) ──────────
# Dapatkan dari: https://aistudio.google.com/apikey
# VITE_GEMINI_API_KEY=your_gemini_api_key

# ─── OPSIONAL: OCR.space API (Auto-OCR Dokumen) ──────────
# Free 25.000 request/bulan. Daftar di: https://ocr.space/ocrapi
# VITE_OCR_SPACE_KEY=your_ocr_space_api_key
